<?xml version="1.0"?>
<ruleset
		name="FOCUS PHPCS Ruleset"
		xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<description>Custom ruleset for FOCUS.</description>

	<!-- What to scan -->
	<file>./includes/</file>
	<file>./focus.php</file>

	<!-- Ignoring Files and Folders:
		https://github.com/squizlabs/PHP_CodeSniffer/wiki/Advanced-Usage#ignoring-files-and-folders -->
	<exclude-pattern>/tests/</exclude-pattern>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/\.phpunit.cache/</exclude-pattern>
	<exclude-pattern>/\$WP_TESTS_DIR/</exclude-pattern>

	<!-- How to scan -->
	<arg value="sp"/> <!-- Show sniff and progress -->
	<arg name="colors"/> <!-- Show results with colors. Disable if working on Windows -->
	<arg name="basepath" value="."/> <!-- Strip the file paths down to the relevant bit -->
	<arg name="parallel" value="8"/> <!-- Enables parallel processing when available for faster results -->
	<arg name="extensions" value="php"/> <!-- Limit to PHP and JS files -->

	<!-- Rules: Check PHP version compatibility - see
		https://github.com/PHPCompatibility/PHPCompatibilityWP -->
	<rule ref="PHPCompatibilityWP"/>
	<!-- For help in understanding this testVersion:
		https://github.com/PHPCompatibility/PHPCompatibility#sniffing-your-code-for-compatibility-with-specific-php-versions -->
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- For help in understanding this minimum_supported_wp_version: https://github.com/WordPress-Coding-Standards/WordPress-Coding-Standards/wiki/Customizable-sniff-properties#setting-minimum-supported-wp-version-for-all-sniffs-in-one-go-wpcs-0140 -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<!-- Add in our custom text domain -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="focus-cache"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="focus"/>
				<element value="FOCUS"/>
				<element value="wp_cache"/>
				<element value="WP_Object_Cache"/>
				<element value="WP_FOCUS"/>
			</property>
		</properties>
	</rule>

	<!-- Set minimum cron interval to 5 minutes -->
	<rule ref="WordPress.WP.CronInterval">
		<properties>
			<property name="min_interval" value="300"/>
		</properties>
	</rule>

	<!-- Ignore Squiz.Commenting.FileComment.MissingPackageTag -->
	<rule ref="Squiz.Commenting.FileComment.MissingPackageTag">
		<exclude name="Squiz.Commenting.FileComment.MissingPackageTag" />
		<exclude name="Squiz.Commenting.FileComment.Missing" />
	</rule>

	<!-- Ignore Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed">
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed" />
	</rule>

	<!-- Ignore WordPress.Files.FileName.InvalidClassFileName -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName" />
	</rule>

	<!-- Ignore Universal.Files.SeparateFunctionsFromOO.Mixed -->
	<rule ref="Universal.Files.SeparateFunctionsFromOO.Mixed">
		<exclude name="Universal.Files.SeparateFunctionsFromOO.Mixed" />
	</rule>

	<!-- The object-cache drop-in must be self-contained, including concrete backend classes. -->
	<rule ref="Generic.Files.OneObjectStructurePerFile.MultipleFound">
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
	</rule>

	<!-- Coverage annotations intentionally sit adjacent to the guarded lines they exclude. -->
	<rule ref="Emrikol.Comments.InlineCommentPeriod">
		<exclude-pattern>includes/admin-page.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-cache.php</exclude-pattern>
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
	</rule>

	<!-- Custom Sniffs — emrikol/phpcs -->
	<rule ref="Emrikol"/>

	<!-- Namespace exclusions — files that legitimately live in the global namespace -->
	<rule ref="Emrikol.Namespaces.Namespace.MissingNamespace">
		<exclude-pattern>focus.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-query-monitor.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-qm-data-prefetch.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-qm-collector-prefetch.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-qm-output-html-prefetch.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-cache.php</exclude-pattern>
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
		<exclude-pattern>includes/admin-page.php</exclude-pattern>
	</rule>

	<!-- Query Monitor adapter classes must match Query Monitor's global, untyped override signatures. -->
	<rule ref="Emrikol.Classes.TypedProperty">
		<exclude-pattern>includes/class-focus-qm-data-prefetch.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-qm-collector-prefetch.php</exclude-pattern>
	</rule>
	<rule ref="Emrikol.Functions.TypeDeclaration">
		<exclude-pattern>includes/class-focus-qm-collector-prefetch.php</exclude-pattern>
		<exclude-pattern>includes/class-focus-qm-output-html-prefetch.php</exclude-pattern>
	</rule>

	<!-- Cache data is genuinely mixed — suppress in object-cache.php -->
	<rule ref="Emrikol.PHP.DiscouragedMixedType">
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
	</rule>

	<!-- WordPress object-cache drop-ins must match core's untyped public API. -->
	<rule ref="Emrikol.PHP.StrictTypes">
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
	</rule>
	<rule ref="Emrikol.Functions.TypeHinting">
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
	</rule>
	<rule ref="Emrikol.Functions.TypeDeclaration">
		<exclude-pattern>includes/object-cache.php</exclude-pattern>
	</rule>

	<!-- WordPress presets -->
	<rule ref="./vendor/emrikol/phpcs/presets/wordpress-classes.xml"/>
	<rule ref="./vendor/emrikol/phpcs/presets/wordpress-global-classes.xml"/>
	<rule ref="./vendor/emrikol/phpcs/presets/php-global-classes.xml"/>
</ruleset>
